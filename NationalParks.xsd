<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:element name="NationalParks">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name = "NationalPark" maxOccurs="unbounded">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name = "Name" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                            <xsd:element name = "Phone" minOccurs="1" maxOccurs="unbounded" type="xsd:string" />
                            <xsd:element name = "Address" minOccurs="1" maxOccurs="1">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name = "Number" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                                        <xsd:element name = "Street" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                                        <xsd:element name = "City" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                                        <xsd:element name = "State" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                                        <xsd:element name = "Zip" minOccurs="1" maxOccurs="1" type="xsd:string"/>
                                    </xsd:sequence>
                                    <xsd:attribute name = "NearestAirport" type = "xsd:string" use = "optional" />
                                </xsd:complexType> 
                            </xsd:element>
                        </xsd:sequence>
                        <xsd:attribute name = "Rating" type="xsd:string" use="optional" />
                    </xsd:complexType>
                </xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>